# Lava. Preferred for this demo when configured.
LAVA_API_BASE_URL=https://api.lava.so/v1
LAVA_SECRET_KEY=
LAVA_MODEL=gpt-4.1-mini

# K2 Think. Used if Lava is not configured.
K2_BASE_URL=https://api.k2think.ai/v1
K2_API_KEY=
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# Optional fallback for standard OpenAI API usage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Retell AI - outbound reservation calls (https://retellai.com)
RETELL_API_KEY=
# Caller ID you own in Retell (E.164, e.g. +14157774444)
RETELL_FROM_NUMBER=
# Recommended: force your reservation agent for every outbound attempt.
# Use this if your Retell phone number does not already have an outbound agent assigned.
RETELL_AGENT_ID=

# Safe testing: send all reservation dials to one real handset instead of fixture restaurant numbers.
# This is where your personal phone number goes during demos. E.164 format, e.g. +12025551234.
TABLECALL_DIAL_OVERRIDE=

# Optional tuning for polling Retell after a call is placed.
RETELL_POLL_INTERVAL_SECONDS=2
RETELL_CALL_MAX_WAIT_SECONDS=180
