# Lava. Preferred for this demo when configured.
LAVA_API_BASE_URL=https://api.lava.so/v1
LAVA_SECRET_KEY=
LAVA_MODEL=gpt-4.1-mini

# K2 Think. Used if Lava is not configured.
K2_BASE_URL=https://api.k2think.ai/v1
K2_API_KEY=
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# Optional fallback for standard OpenAI API usage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
